{
  "name": "dayflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "test:integration": "node scripts/integration.mjs",
    "verify:production": "node --env-file-if-exists=.env scripts/check-production.mjs",
    "prestart": "npm run verify:production",
    "format": "prettier --write src scripts vite.config.ts drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.20",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@tanstack/react-query": "5.91.2",
    "@tanstack/react-router": "1.170.34",
    "@tanstack/react-router-ssr-query": "1.166.9",
    "@tanstack/react-start": "1.168.51",
    "better-auth": "1.4.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.43.0",
    "motion": "12.43.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.3",
    "zod": "4.6.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "seroval": "1.6.7",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
